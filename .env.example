# ==============================================================================
# Portfolio CMS — Environment Configuration
# ==============================================================================

# Data adapter mode:
# - "fixture": Lightweight read-only local fixture adapter for local dev & automated tests
# - "supabase": Production Supabase PostgreSQL source of truth (never falls back silently)
DATA_ADAPTER_MODE=fixture

# Supabase Public Configuration (Safe for Browser & Server SSR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-ONLY — NEVER expose to browser or prefix with NEXT_PUBLIC_)
# Used exclusively for trusted server-side admin provisioning / maintenance scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated Admin Session HMAC Secret (SERVER-ONLY — min 32 random characters)
# Strictly required in production and when DATA_ADAPTER_MODE=supabase.
# Standalone secret without fallback; application fails securely if missing.
ADMIN_SESSION_SECRET=

# Optional Single-Admin Email Allowlist Override (Server-side defense-in-depth alongside admin_users table)
ADMIN_ALLOWED_EMAIL=

# Fixture Mode Admin Password (LOCAL DEVELOPMENT / TEST ONLY — never used in Supabase mode)
ADMIN_FIXTURE_PASSWORD=portfolio-admin-2026-secret

# Public Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://muhamadfauzan.dev

# Dedicated HMAC Secret for IP-Based Daily Visitor Fingerprinting (SERVER-ONLY)
VISITOR_HASH_SECRET=
