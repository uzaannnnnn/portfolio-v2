# Data adapter mode: "fixture" (default for local dev/CI without cloud DB) or "supabase" (production source of truth)
DATA_ADAPTER_MODE=fixture

# Supabase Configuration (Required when DATA_ADAPTER_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Site Metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
